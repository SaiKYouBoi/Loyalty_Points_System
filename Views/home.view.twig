<!DOCTYPE html>

<html class="light" lang="en">
	<head>
		<meta charset="utf-8"/>
		<meta content="width=device-width, initial-scale=1.0" name="viewport"/>
		<title>User Dashboard</title>
		<script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
		<link href="https://fonts.googleapis.com" rel="preconnect"/>
		<link crossorigin="" href="https://fonts.gstatic.com" rel="preconnect"/>
		<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;700;900&amp;display=swap" rel="stylesheet"/>
		<link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap" rel="stylesheet"/>
		<link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap" rel="stylesheet"/>
		<script id="tailwind-config">
			tailwind.config = {
darkMode: "class",
theme: {
extend: {
colors: {
primary: "#136dec",
"background-light": "#f6f7f8",
"background-dark": "#101822"
},
fontFamily: {
display: ["Inter", "sans-serif"]
},
borderRadius: {
DEFAULT: "0.25rem",
lg: "0.5rem",
xl: "0.75rem",
full: "9999px"
}
}
}
};
		</script>
		<style>
			.material-symbols-outlined {
				font-variation-settings: "FILL" 0, "wght" 400, "GRAD" 0, "opsz" 24;
				font-size: inherit;
				line-height: 1;
			}
		</style>
	</head>
	<body class="bg-background-light dark:bg-background-dark font-display text-gray-800 dark:text-gray-200">
		<div class="relative flex h-auto min-h-screen w-full flex-col group/design-root overflow-x-hidden">
			<div class="layout-container flex h-full grow flex-col">
				<header class="flex items-center justify-between whitespace-nowrap border-b border-gray-200 dark:border-gray-800 px-6 md:px-10 lg:px-20 py-4 bg-white dark:bg-background-dark">
					<div class="flex items-center gap-4 text-gray-900 dark:text-white">
						<div class="size-6 text-primary">
							<svg fill="none" viewbox="0 0 48 48" xmlns="http://www.w3.org/2000/svg">
								<g clip-path="url(#clip0_6_330)">
									<path clip-rule="evenodd" d="M24 0.757355L47.2426 24L24 47.2426L0.757355 24L24 0.757355ZM21 35.7574V12.2426L9.24264 24L21 35.7574Z" fill="currentColor" fill-rule="evenodd"></path>
								</g>
								<defs>
									<clippath id="clip0_6_330">
										<rect fill="white" height="48" width="48"></rect>
									</clippath>
								</defs>
							</svg>
						</div>
						<h2 class="text-xl font-bold leading-tight tracking-[-0.015em]">
							ShopEasy
						</h2>
					</div>
					<div class="flex flex-1 justify-end items-center gap-4">
            <form action="/logout" method="post">
						<button class="flex min-w-[84px] max-w-[480px] cursor-pointer items-center justify-center overflow-hidden rounded-lg h-10 px-4 bg-gray-100 dark:bg-gray-800 text-gray-800 dark:text-gray-200 text-sm font-bold leading-normal tracking-[0.015em] hover:bg-gray-200 dark:hover:bg-gray-700 transition-colors">
							<span class="truncate">Logout</span>
						</button>
          </form>
						<div class="bg-center bg-no-repeat aspect-square bg-cover rounded-full size-10" data-alt="User avatar with a gradient background" style="
							                background-image: url('https://lh3.googleusercontent.com/aida-public/AB6AXuC4Bd6nVHjZ0kFWdPM8JMj8hJk0-2m6hBhcWMG68enGa-72HafB9pnUinL1jfGli0kxGv5ACS0jpucM7KCE8G4Iw3K4ldoMweLVPy0YsyJHHiytLThi7IAICpKR9A32gf2H6KGZlDcLe1UiaFxaZBfdsSeVAAOjYh1oCVPnXUS_-DQfYAZoPx4mIwNyhJhS0mfZmqu6H80ThDNPSwqQJEKRi6vhMaqW77-Mrk9OojwZTKy8zDjzcCBtfPSRxbKlMmqg_MT0btYAV-LZ');
							              "></div>
					</div>
				</header>
				<main class="flex-1 px-4 sm:px-6 lg:px-8 py-8">
					<div class="max-w-4xl mx-auto">
						<div class="flex flex-wrap justify-between gap-4 p-4">
							<p class="text-gray-900 dark:text-white text-4xl font-black leading-tight tracking-[-0.033em] min-w-72">
								Welcome back, Alex!
							</p>
						</div>
						<div class="grid grid-cols-1 md:grid-cols-3 gap-6 p-4">
							<div class="md:col-span-3">
								<div class="flex flex-col items-stretch justify-start rounded-xl shadow-sm bg-white dark:bg-gray-900 overflow-hidden">
									<div class="flex w-full min-w-72 grow flex-col items-stretch justify-center gap-2 p-6">
										<p class="text-gray-500 dark:text-gray-400 text-base font-normal leading-normal">
											Your Points Balance
										</p>
										<p class="text-primary text-5xl font-bold leading-tight tracking-[-0.015em]">
											5,430
										</p>
										<p class="text-gray-500 dark:text-gray-400 text-base font-normal leading-normal">
											Available to spend
										</p>
									</div>
								</div>
							</div>
							<div class="md:col-span-2 bg-white dark:bg-gray-900 p-6 rounded-xl shadow-sm">
								<h2 class="text-gray-900 dark:text-white text-[22px] font-bold leading-tight tracking-[-0.015em] pb-4">
									How to Earn
								</h2>
								<div class="flex flex-col divide-y divide-gray-200 dark:divide-gray-800">
									<div class="flex items-center gap-4 py-4 justify-between">
										<div class="flex items-center gap-4">
											<div class="text-primary flex items-center justify-center rounded-lg bg-primary/20 shrink-0 size-12 text-2xl">
												<span class="material-symbols-outlined">shopping_bag</span>
											</div>
											<div class="flex flex-col justify-center">
												<p class="text-gray-900 dark:text-white text-base font-medium leading-normal line-clamp-1">
													Shop &amp; Earn
												</p>
												<p class="text-gray-500 dark:text-gray-400 text-sm font-normal leading-normal line-clamp-2">
													Get 1 point for every $1 you spend.
												</p>
											</div>
										</div>
										<div class="shrink-0 text-gray-400 dark:text-gray-500 text-2xl">
											<span class="material-symbols-outlined">chevron_right</span>
										</div>
									</div>
									<div class="flex items-center gap-4 py-4 justify-between">
										<div class="flex items-center gap-4">
											<div class="text-primary flex items-center justify-center rounded-lg bg-primary/20 shrink-0 size-12 text-2xl">
												<span class="material-symbols-outlined">rate_review</span>
											</div>
											<div class="flex flex-col justify-center">
												<p class="text-gray-900 dark:text-white text-base font-medium leading-normal line-clamp-1">
													Review Products
												</p>
												<p class="text-gray-500 dark:text-gray-400 text-sm font-normal leading-normal line-clamp-2">
													Earn 50 points for approved reviews.
												</p>
											</div>
										</div>
										<div class="shrink-0 text-gray-400 dark:text-gray-500 text-2xl">
											<span class="material-symbols-outlined">chevron_right</span>
										</div>
									</div>
									<div class="flex items-center gap-4 py-4 justify-between">
										<div class="flex items-center gap-4">
											<div class="text-primary flex items-center justify-center rounded-lg bg-primary/20 shrink-0 size-12 text-2xl">
												<span class="material-symbols-outlined">cake</span>
											</div>
											<div class="flex flex-col justify-center">
												<p class="text-gray-900 dark:text-white text-base font-medium leading-normal line-clamp-1">
													Birthday Bonus
												</p>
												<p class="text-gray-500 dark:text-gray-400 text-sm font-normal leading-normal line-clamp-2">
													Get 200 points on your birthday!
												</p>
											</div>
										</div>
										<div class="shrink-0 text-gray-400 dark:text-gray-500 text-2xl">
											<span class="material-symbols-outlined">chevron_right</span>
										</div>
									</div>
								</div>
							</div>
							<div class="md:col-span-1 bg-white dark:bg-gray-900 p-6 rounded-xl shadow-sm flex flex-col justify-center gap-4">
								<a href="/reward">
								<button class="w-full flex cursor-pointer items-center justify-center rounded-lg h-12 px-6 bg-primary text-white text-base font-bold leading-normal tracking-[-0.015em] hover:bg-primary/90 transition-colors">
									<span class="truncate">Redeem Rewards</span>
								</button>
								</a>
								<a href="/transactions">
								<button class="w-full flex cursor-pointer items-center justify-center rounded-lg h-12 px-6 bg-gray-100 dark:bg-gray-800 text-gray-800 dark:text-gray-200 text-base font-bold leading-normal tracking-[-0.015em] hover:bg-gray-200 dark:hover:bg-gray-700 transition-colors">
									<span class="truncate">View Points History</span>
								</button>
								</a>
								<div
									class="fixed top-5 right-5 flex flex-col gap-4">

									<!-- Success Alert -->
									{@ if session().has("success") @}
									<div class="max-w-xs flex-wrap items-start justify-between gap-4 rounded-lg border border-green-200 bg-green-50 p-4 text-slate-900 dark:border-green-800 dark:bg-green-900/40 dark:text-white" role="alert">
										<div class="flex items-center gap-3">
											<span class="material-symbols-outlined text-green-500">check_circle</span>
											<div class="flex flex-col">
												<p class="text-sm font-bold">Success!</p>
												<p class="text-sm">{{ session().getFlash("success") }}</p>
											</div>
										</div>
									</div>
									{@ endif @}
								</div>
							</div>
						</div>
					</main>
				</div>
			</div>
		</body>
	</body>
</html>
