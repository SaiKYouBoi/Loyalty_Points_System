{@ include 'header.layout.twig' @}
			<!-- Main Content -->
			<main class="flex w-full flex-1 items-center justify-center py-12 sm:py-16 lg:py-20">
				<div class="w-full max-w-md px-4 sm:px-0">
					<div
						class="flex flex-col gap-8 rounded-xl bg-white dark:bg-background-dark dark:border dark:border-slate-800 p-8 shadow-sm">

						<!-- Page Heading -->
						<div class="flex flex-col gap-2 text-center">
							<h1 class="text-slate-900 dark:text-white text-4xl font-black leading-tight tracking-[-0.033em]">
								Create your ShopEasy Account
							</h1>
							<p class="text-slate-500 dark:text-slate-400 text-base font-normal leading-normal">
								Join our loyalty program and start earning points today.
							</p>
						</div>
						<form
							action="/register" method="POST">
							<!-- Registration Form -->
							<div
								class="flex flex-col gap-6">
								<!-- Full Name -->
								<div class="flex flex-col">
									<label class="text-slate-800 dark:text-slate-200 text-sm font-medium leading-normal pb-2" for="fullName">Full Name</label>
									<input class="form-input flex w-full min-w-0 flex-1 resize-none overflow-hidden rounded-lg text-slate-900 dark:text-white focus:outline-0 focus:ring-2 focus:ring-primary/50 border border-slate-300 dark:border-slate-600 bg-white dark:bg-background-dark h-12 placeholder:text-slate-400 dark:placeholder:text-slate-500 px-4 text-base font-normal leading-normal" value="{@ if session().has("name") @}{{ session().getFlash('name') }}{@ endif @}" id="fullName" placeholder="Enter your full name" type="text" name="name"/>

									{@ if session().has("name-err") @}<div class="error mt-2 text-[14px] text-red-500/80">
										{{ session().getFlash("name-err") }}
									</div>
									{@ endif @}
								</div>
								<!-- Email Address -->
								<div class="flex flex-col">
									<label class="text-slate-800 dark:text-slate-200 text-sm font-medium leading-normal pb-2" for="email">Email Address</label>
									<input class="form-input flex w-full min-w-0 flex-1 resize-none overflow-hidden rounded-lg text-slate-900 dark:text-white focus:outline-0 focus:ring-2 focus:ring-primary/50 border border-slate-300 dark:border-slate-600 bg-white dark:bg-background-dark h-12 placeholder:text-slate-400 dark:placeholder:text-slate-500 px-4 text-base font-normal leading-normal" value="{@ if session().has("email") @}{{ session().getFlash('email') }}{@ endif @}" id="email" placeholder="you@example.com" type="email" name="email"/>
									{@ if session().has("email-err") @}<div class="error mt-2 text-[14px] text-red-500/80">
										{{ session().getFlash("email-err") }}
									</div>
									{@ endif @}
								</div>
								<!-- Password -->
								<div class="flex flex-col">
									<label class="text-slate-800 dark:text-slate-200 text-sm font-medium leading-normal pb-2" for="password">Password</label>
									<div class="relative w-full">
										<input class="form-input flex w-full min-w-0 flex-1 resize-none overflow-hidden rounded-lg text-slate-900 dark:text-white focus:outline-0 focus:ring-2 focus:ring-primary/50 border border-slate-300 dark:border-slate-600 bg-white dark:bg-background-dark h-12 placeholder:text-slate-400 dark:placeholder:text-slate-500 px-4 pr-12 text-base font-normal leading-normal" id="password" placeholder="Enter your password" type="password" name="password"/>
										{@ if session().has("password-err") @}<div class="error mt-2 text-[14px] text-red-500/80">
											{{ session().getFlash("password-err") }}
										</div>
										{@ endif @}
										<button aria-label="Toggle password visibility" class="absolute inset-y-0 right-0 flex items-center px-4 text-slate-400 dark:text-slate-500 hover:text-primary dark:hover:text-primary">
											<span class="material-symbols-outlined text-xl">visibility_off</span>
										</button>
									</div>
									<p class="text-xs text-slate-500 dark:text-slate-400 mt-2">
										8+ characters, with at least one number.
									</p>
								</div>
								<!-- Confirm Password -->
								<div class="flex flex-col">
									<label class="text-slate-800 dark:text-slate-200 text-sm font-medium leading-normal pb-2" for="confirmPassword">Confirm Password</label>
									<input class="form-input flex w-full min-w-0 flex-1 resize-none overflow-hidden rounded-lg text-slate-900 dark:text-white focus:outline-0 focus:ring-2 focus:ring-primary/50 border border-slate-300 dark:border-slate-600 bg-white dark:bg-background-dark h-12 placeholder:text-slate-400 dark:placeholder:text-slate-500 px-4 text-base font-normal leading-normal" id="confirmPassword" placeholder="Confirm your password" type="password" name="confirm_password"/>

									{@ if session().has("confirm_password-err") @}<div class="error mt-2 text-[14px] text-red-500/80">
										{{ session().getFlash("confirm_password-err") }}
									</div>
									{@ endif @}

								</div>
								<!-- CTA Button -->
								<button class="flex min-w-[84px] cursor-pointer items-center justify-center overflow-hidden rounded-lg h-12 px-4 bg-primary text-white text-base font-bold leading-normal tracking-wide w-full mt-2 hover:bg-primary/90 transition-colors" type="submit">
									<span class="truncate">Join the Loyalty Program</span>
								</button>
							</div>
						</form>
						<!-- Footer Link -->
						<p class="text-center text-sm text-slate-500 dark:text-slate-400">
							Already a member?
							<a class="font-bold text-primary hover:underline" href="/login">Sign In</a>
						</p>
					</div>
					<!-- Example Feedback Toasts (Initially Hidden) -->
					<div
						class="fixed top-5 right-5 flex flex-col gap-4">
						<!-- Success Alert -->
						<div class="hidden max-w-xs flex-wrap items-start justify-between gap-4 rounded-lg border border-green-200 bg-green-50 p-4 text-slate-900 dark:border-green-800 dark:bg-green-900/40 dark:text-white" role="alert">
							<div class="flex items-center gap-3">
								<span class="material-symbols-outlined text-green-500">check_circle</span>
								<div class="flex flex-col">
									<p class="text-sm font-bold">Success!</p>
									<p class="text-sm">Your account has been created.</p>
								</div>
							</div>
							<button aria-label="Close" class="p-1 -m-1">
								<span class="material-symbols-outlined text-base">close</span>
							</button>
						</div>
						<!-- Error Alert -->
						<div class="hidden max-w-xs flex-wrap items-start justify-between gap-4 rounded-lg border border-red-200 bg-red-50 p-4 text-slate-900 dark:border-red-800 dark:bg-red-900/40 dark:text-white" role="alert">
							<div class="flex items-center gap-3">
								<span class="material-symbols-outlined text-red-500">error</span>
								<div class="flex flex-col">
									<p class="text-sm font-bold">Error</p>
									<p class="text-sm"></p>
								</div>
							</div>
						</div>
					</div>
				</div>
			</main>
		</div>
		{@ include 'footer.layout.twig' @}
	</body>
</html>
