<!DOCTYPE html>

<html class="light" lang="en">
	<head>
		<meta charset="utf-8"/>
		<meta content="width=device-width, initial-scale=1.0" name="viewport"/>
		<title>Points Transaction History Page</title>
		<script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
		<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&amp;display=swap" rel="stylesheet"/>
		<link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200" rel="stylesheet"/>
		<link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap" rel="stylesheet"/>
		<style>
			.material-symbols-outlined {
				font-variation-settings: 'FILL' 0, 'wght' 400, 'GRAD' 0, 'opsz' 24
			}
		</style>
		<script id="tailwind-config">
			tailwind.config = {
darkMode: "class",
theme: {
extend: {
colors: {
"primary": "#136dec",
"background-light": "#f6f7f8",
"background-dark": "#101822"
},
fontFamily: {
"display": ["Inter", "sans-serif"]
},
borderRadius: {
"DEFAULT": "0.25rem",
"lg": "0.5rem",
"xl": "0.75rem",
"full": "9999px"
}
}
}
}
		</script>
	</head>
	<body class="font-display">
		<div class="relative flex h-auto min-h-screen w-full flex-col bg-background-light dark:bg-background-dark group/design-root overflow-x-hidden">
			<div
				class="layout-container flex h-full grow flex-col">
				<!-- TopNavBar -->
				<header class="flex items-center justify-between whitespace-nowrap border-b border-solid border-slate-200 dark:border-slate-800 px-10 py-3 bg-white dark:bg-background-dark">
					<div class="flex items-center gap-4 text-slate-900 dark:text-white">
						<div class="size-6 text-primary">
							<svg fill="none" viewbox="0 0 48 48" xmlns="http://www.w3.org/2000/svg">
								<g clip-path="url(#clip0_6_330)">
									<path clip-rule="evenodd" d="M24 0.757355L47.2426 24L24 47.2426L0.757355 24L24 0.757355ZM21 35.7574V12.2426L9.24264 24L21 35.7574Z" fill="currentColor" fill-rule="evenodd"></path>
								</g>
								<defs>
									<clippath id="clip0_6_330">
										<rect fill="white" height="48" width="48"></rect>
									</clippath>
								</defs>
							</svg>
						</div>
						<h2 class="text-slate-900 dark:text-white text-lg font-bold leading-tight tracking-[-0.015em]">ShopEasy</h2>
					</div>
					<div class="flex flex-1 justify-end gap-8">
						<div class="flex items-center gap-9">
							<a class="text-slate-600 dark:text-slate-300 text-sm font-medium leading-normal hover:text-primary dark:hover:text-primary" href="#">Home</a>
							<a class="text-slate-600 dark:text-slate-300 text-sm font-medium leading-normal hover:text-primary dark:hover:text-primary" href="#">Shop</a>
							<a class="text-primary dark:text-primary text-sm font-semibold leading-normal" href="#">My Account</a>
							<a class="text-slate-600 dark:text-slate-300 text-sm font-medium leading-normal hover:text-primary dark:hover:text-primary" href="#">Help</a>
						</div>
						<button class="flex min-w-[84px] max-w-[480px] cursor-pointer items-center justify-center overflow-hidden rounded-lg h-10 px-4 bg-primary text-white text-sm font-bold leading-normal tracking-[0.015em]">
							<span class="truncate">My Points: 1,250</span>
						</button>
						<div class="bg-center bg-no-repeat aspect-square bg-cover rounded-full size-10" data-alt="User avatar with a gradient background" style='background-image: url("https://lh3.googleusercontent.com/aida-public/AB6AXuBFDMWdAfG0LyOT55i3w4Yn8hkrZrPp_AR7-RMAYFfPjpnskhC9-ofxNXi5j5aL5QCtCb9uLiQGTyaLIQfKf9UMsxzyajREymfEGlSk7igBqnsL3UY68JL2p9VkCVwdCgfkgLAWzSev3zU9po9obRgAbvnWAJDUKh4AwtQlqR2-fRN2mPCLHGNLkUA1B1S2D1zVV9vNX9_zvoTC5HICu4G9hV9-kWUcgkruNsOxeuxOBntWkcX08fSXOik4hLHPEZHFXxHt5RH3Tksh");'></div>
					</div>
				</header>
				<!-- Main Content -->
				<div class="px-4 py-5 sm:px-10 md:px-20 lg:px-40 flex flex-1 justify-center">
					<div
						class="layout-content-container flex flex-col max-w-5xl flex-1 gap-6">
						<!-- PageHeading -->
						<div class="flex flex-wrap justify-between gap-3 pt-4">
							<p class="text-slate-900 dark:text-white text-4xl font-black leading-tight tracking-[-0.033em] min-w-72">Points Transaction History</p>
						</div>
						<!-- Filters Section -->
						<div class="flex flex-col gap-4 rounded-xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900/50 p-4">
							<div class="grid grid-cols-1 md:grid-cols-3 gap-4 items-end">
								<div class="flex flex-col gap-1.5">
									<label class="text-slate-600 dark:text-slate-300 text-sm font-medium" for="transaction-type">Transaction Type</label>
									<div class="relative">
										<select class="w-full appearance-none rounded-lg border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-900 px-3 py-2 text-sm text-slate-900 dark:text-slate-100 focus:border-primary focus:outline-none focus:ring-2 focus:ring-primary/20" id="transaction-type">
											<option>All Types</option>
											<option>Earned</option>
											<option>Redeemed</option>
											<option>Expired</option>
										</select>
										<span class="material-symbols-outlined pointer-events-none absolute right-3 top-1/2 -translate-y-1/2 text-slate-400">expand_more</span>
									</div>
								</div>
								<div class="grid grid-cols-2 gap-4 col-span-1 md:col-span-2">
									<div class="flex flex-col gap-1.5">
										<label class="text-slate-600 dark:text-slate-300 text-sm font-medium" for="start-date">Start Date</label>
										<div class="relative">
											<input class="w-full rounded-lg border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-900 px-3 py-2 text-sm text-slate-900 dark:text-slate-100 focus:border-primary focus:outline-none focus:ring-2 focus:ring-primary/20" id="start-date" type="date" value="2023-08-01"/>
										</div>
									</div>
									<div class="flex flex-col gap-1.5">
										<label class="text-slate-600 dark:text-slate-300 text-sm font-medium" for="end-date">End Date</label>
										<div class="relative">
											<input class="w-full rounded-lg border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-900 px-3 py-2 text-sm text-slate-900 dark:text-slate-100 focus:border-primary focus:outline-none focus:ring-2 focus:ring-primary/20" id="end-date" type="date" value="2023-10-31"/>
										</div>
									</div>
								</div>
							</div>
							<div class="flex justify-start">
								<button class="flex h-10 cursor-pointer items-center justify-center gap-2 overflow-hidden rounded-lg bg-primary px-4 text-sm font-bold leading-normal tracking-[0.015em] text-white">
									<span class="material-symbols-outlined">filter_list</span>
									<span class="truncate">Apply Filters</span>
								</button>
							</div>
						</div>
						<!-- Table -->
						<div class="@container">
							<div class="overflow-hidden rounded-xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900/50">
								<table class="w-full">
									<thead class="bg-slate-100 dark:bg-slate-800/50">
										<tr>
											<th class="px-4 py-3 text-left text-slate-600 dark:text-slate-300 w-1/5 text-sm font-medium leading-normal">Date</th>
											<th class="px-4 py-3 text-left text-slate-600 dark:text-slate-300 w-2/5 text-sm font-medium leading-normal">Description</th>
											<th class="px-4 py-3 text-left text-slate-600 dark:text-slate-300 w-1/5 text-sm font-medium leading-normal">Type</th>
											<th class="px-4 py-3 text-right text-slate-600 dark:text-slate-300 w-1/5 text-sm font-medium leading-normal">Points</th>
											<th class="px-4 py-3 text-right text-slate-600 dark:text-slate-300 w-1/5 text-sm font-medium leading-normal">Balance</th>
										</tr>
									</thead>
									<tbody>
										<tr class="border-t border-t-slate-200 dark:border-t-slate-800">
											<td class="h-[72px] px-4 py-2 text-slate-500 dark:text-slate-400 text-sm font-normal leading-normal">Oct 26, 2023</td>
											<td class="h-[72px] px-4 py-2 text-slate-700 dark:text-slate-200 text-sm font-medium leading-normal">Order #SHP12345</td>
											<td class="h-[72px] px-4 py-2 text-sm font-normal leading-normal">
												<span class="inline-flex items-center rounded-full bg-green-100 dark:bg-green-900/50 px-3 py-1 text-xs font-medium text-green-700 dark:text-green-300">Earned</span>
											</td>
											<td class="h-[72px] px-4 py-2 text-right text-green-600 dark:text-green-400 text-sm font-medium leading-normal">+50</td>
											<td class="h-[72px] px-4 py-2 text-right text-slate-500 dark:text-slate-400 text-sm font-normal leading-normal">1,250 pts</td>
										</tr>
										<tr class="border-t border-t-slate-200 dark:border-t-slate-800">
											<td class="h-[72px] px-4 py-2 text-slate-500 dark:text-slate-400 text-sm font-normal leading-normal">Oct 15, 2023</td>
											<td class="h-[72px] px-4 py-2 text-slate-700 dark:text-slate-200 text-sm font-medium leading-normal">Points Redeemed for Coupon</td>
											<td class="h-[72px] px-4 py-2 text-sm font-normal leading-normal">
												<span class="inline-flex items-center rounded-full bg-orange-100 dark:bg-orange-900/50 px-3 py-1 text-xs font-medium text-orange-700 dark:text-orange-300">Redeemed</span>
											</td>
											<td class="h-[72px] px-4 py-2 text-right text-orange-600 dark:text-orange-400 text-sm font-medium leading-normal">-200</td>
											<td class="h-[72px] px-4 py-2 text-right text-slate-500 dark:text-slate-400 text-sm font-normal leading-normal">1,200 pts</td>
										</tr>
										<tr class="border-t border-t-slate-200 dark:border-t-slate-800">
											<td class="h-[72px] px-4 py-2 text-slate-500 dark:text-slate-400 text-sm font-normal leading-normal">Sep 30, 2023</td>
											<td class="h-[72px] px-4 py-2 text-slate-700 dark:text-slate-200 text-sm font-medium leading-normal">Monthly Points Expiration</td>
											<td class="h-[72px] px-4 py-2 text-sm font-normal leading-normal">
												<span class="inline-flex items-center rounded-full bg-red-100 dark:bg-red-900/50 px-3 py-1 text-xs font-medium text-red-700 dark:text-red-300">Expired</span>
											</td>
											<td class="h-[72px] px-4 py-2 text-right text-red-600 dark:text-red-400 text-sm font-medium leading-normal">-10</td>
											<td class="h-[72px] px-4 py-2 text-right text-slate-500 dark:text-slate-400 text-sm font-normal leading-normal">1,400 pts</td>
										</tr>
										<tr class="border-t border-t-slate-200 dark:border-t-slate-800">
											<td class="h-[72px] px-4 py-2 text-slate-500 dark:text-slate-400 text-sm font-normal leading-normal">Sep 12, 2023</td>
											<td class="h-[72px] px-4 py-2 text-slate-700 dark:text-slate-200 text-sm font-medium leading-normal">Order #SHP12311</td>
											<td class="h-[72px] px-4 py-2 text-sm font-normal leading-normal">
												<span class="inline-flex items-center rounded-full bg-green-100 dark:bg-green-900/50 px-3 py-1 text-xs font-medium text-green-700 dark:text-green-300">Earned</span>
											</td>
											<td class="h-[72px] px-4 py-2 text-right text-green-600 dark:text-green-400 text-sm font-medium leading-normal">+150</td>
											<td class="h-[72px] px-4 py-2 text-right text-slate-500 dark:text-slate-400 text-sm font-normal leading-normal">1,410 pts</td>
										</tr>
										<tr class="border-t border-t-slate-200 dark:border-t-slate-800">
											<td class="h-[72px] px-4 py-2 text-slate-500 dark:text-slate-400 text-sm font-normal leading-normal">Aug 29, 2023</td>
											<td class="h-[72px] px-4 py-2 text-slate-700 dark:text-slate-200 text-sm font-medium leading-normal">Welcome Bonus</td>
											<td class="h-[72px] px-4 py-2 text-sm font-normal leading-normal">
												<span class="inline-flex items-center rounded-full bg-green-100 dark:bg-green-900/50 px-3 py-1 text-xs font-medium text-green-700 dark:text-green-300">Earned</span>
											</td>
											<td class="h-[72px] px-4 py-2 text-right text-green-600 dark:text-green-400 text-sm font-medium leading-normal">+50</td>
											<td class="h-[72px] px-4 py-2 text-right text-slate-500 dark:text-slate-400 text-sm font-normal leading-normal">1,260 pts</td>
										</tr>
									</tbody>
								</table>
							</div>
						</div>
