						<div class="flex flex-col px-4 py-20 border border-dashed border-slate-300 dark:border-slate-700 rounded-xl">
						    <div class="flex flex-col items-center gap-6 text-center">
						        <div class="flex items-center justify-center size-16 bg-slate-100 dark:bg-slate-800 rounded-full text-primary">
						            <span class="material-symbols-outlined !text-4xl">history</span>
						        </div>
						        <div class="flex max-w-sm flex-col items-center gap-2">
						            <p class="text-slate-900 dark:text-white text-lg font-bold leading-tight tracking-[-0.015em]">No Points Activity Yet</p>
						            <p class="text-slate-500 dark:text-slate-400 text-sm font-normal leading-normal">You don’t have any points activity to show for the selected period.</p>
						        </div>
						        <button class="flex min-w-[84px] max-w-[480px] cursor-pointer items-center justify-center overflow-hidden rounded-lg h-10 px-4 bg-slate-200 dark:bg-slate-800 text-slate-900 dark:text-white text-sm font-bold leading-normal tracking-[0.015em]">
						            <span class="truncate">Clear Filters</span>
						        </button>
						    </div>
						</div> 
						-->
					</div>
				</div>
			</div>
		</div>
	</body>
</html>
