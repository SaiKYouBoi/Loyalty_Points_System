{@ include 'header.layout.twig' @}
				
				<!-- Main Content -->
				<div class="px-4 py-5 sm:px-10 md:px-20 lg:px-40 flex flex-1 justify-center">
					<div
						class="layout-content-container flex flex-col max-w-5xl flex-1 gap-6">
						<!-- PageHeading -->
						<div class="flex flex-wrap justify-between gap-3 pt-4">
							<p class="text-slate-900 dark:text-white text-4xl font-black leading-tight tracking-[-0.033em] min-w-72">Points Transaction History</p>
						</div>
						<!-- Filters Section -->
						<div class="flex flex-col gap-4 rounded-xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900/50 p-4">
							<div class="grid grid-cols-1 md:grid-cols-3 gap-4 items-end">
								<div class="flex flex-col gap-1.5">
									<label class="text-slate-600 dark:text-slate-300 text-sm font-medium" for="transaction-type">Transaction Type</label>
									<div class="relative">
										<select class="w-full appearance-none rounded-lg border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-900 px-3 py-2 text-sm text-slate-900 dark:text-slate-100 focus:border-primary focus:outline-none focus:ring-2 focus:ring-primary/20" id="transaction-type">
											<option>All Types</option>
											<option>Earned</option>
											<option>Redeemed</option>
											<option>Expired</option>
										</select>
										<span class="material-symbols-outlined pointer-events-none absolute right-3 top-1/2 -translate-y-1/2 text-slate-400">expand_more</span>
									</div>
								</div>
								<div class="grid grid-cols-2 gap-4 col-span-1 md:col-span-2">
									<div class="flex flex-col gap-1.5">
										<label class="text-slate-600 dark:text-slate-300 text-sm font-medium" for="start-date">Start Date</label>
										<div class="relative">
											<input class="w-full rounded-lg border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-900 px-3 py-2 text-sm text-slate-900 dark:text-slate-100 focus:border-primary focus:outline-none focus:ring-2 focus:ring-primary/20" id="start-date" type="date" value="2023-08-01"/>
										</div>
									</div>
									<div class="flex flex-col gap-1.5">
										<label class="text-slate-600 dark:text-slate-300 text-sm font-medium" for="end-date">End Date</label>
										<div class="relative">
											<input class="w-full rounded-lg border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-900 px-3 py-2 text-sm text-slate-900 dark:text-slate-100 focus:border-primary focus:outline-none focus:ring-2 focus:ring-primary/20" id="end-date" type="date" value="2023-10-31"/>
										</div>
									</div>
								</div>
							</div>
							<div class="flex justify-start">
								<button class="flex h-10 cursor-pointer items-center justify-center gap-2 overflow-hidden rounded-lg bg-primary px-4 text-sm font-bold leading-normal tracking-[0.015em] text-white">
									<span class="material-symbols-outlined">filter_list</span>
									<span class="truncate">Apply Filters</span>
								</button>
							</div>
						</div>
						<!-- Table -->
						<div class="@container">
							<div class="overflow-hidden rounded-xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900/50">
								<table class="w-full">
									<thead class="bg-slate-100 dark:bg-slate-800/50">
										<tr>
											<th class="px-4 py-3 text-center text-slate-600 dark:text-slate-300 w-1/5 text-sm font-medium leading-normal">Date</th>
											<th class="px-4 py-3 text-center text-slate-600 dark:text-slate-300 w-1/5 text-sm font-medium leading-normal">Description</th>
											<th class="px-4 py-3 text-center text-slate-600 dark:text-slate-300 w-1/5 text-sm font-medium leading-normal">Type</th>
											<th class="px-4 py-3 text-center text-slate-600 dark:text-slate-300 w-1/5 text-sm font-medium leading-normal">Points</th>
											<th class="px-4 py-3 text-center text-slate-600 dark:text-slate-300 w-1/5 text-sm font-medium leading-normal">Balance</th>
										</tr>
									</thead>
									<tbody>
										{@ for transaction in transactions @}
										<tr class="border-t border-t-slate-200 dark:border-t-slate-800">
											<td class="h-[72px] px-4 py-2 text-slate-500 dark:text-slate-400 text-sm font-normal leading-normal text-center">{{ transaction.createdat|date("M d, Y") }}</td>
											<td class="h-[72px] px-4 py-2 text-slate-700 dark:text-slate-200 text-sm font-medium leading-normal text-center">Order #SHP12345</td>
											<td class="h-[72px] px-4 py-2 text-sm font-normal leading-normal text-center">
												<span class="inline-flex items-center rounded-full {{ transaction.type == 'earned' ? 'bg-green-100 dark:bg-green-900/50 text-green-700 dark:text-green-300' : 'bg-orange-100 dark:bg-orange-900/50 text-orange-700 dark:text-orange-300' }}  px-3 py-1 text-xs font-medium">{{ transaction.type|capitalize }}</span>
											</td>
											<td class="h-[72px] px-4 py-2 text-center text-green-600 dark:text-green-400 text-sm font-medium leading-normal">{{ transaction.type == 'earned' ? '+' : '-' }} {{ transaction.amount }}</td>
											<td class="h-[72px] px-4 py-2 text-center text-slate-500 dark:text-slate-400 text-sm font-normal leading-normal">{{ transaction.balance_after }} pts</td>
										</tr>
										{@ endfor @}
										
										{# <tr class="border-t border-t-slate-200 dark:border-t-slate-800">
											<td class="h-[72px] px-4 py-2 text-slate-500 dark:text-slate-400 text-sm font-normal leading-normal">Sep 30, 2023</td>
											<td class="h-[72px] px-4 py-2 text-slate-700 dark:text-slate-200 text-sm font-medium leading-normal">Monthly Points Expiration</td>
											<td class="h-[72px] px-4 py-2 text-sm font-normal leading-normal">
												<span class="inline-flex items-center rounded-full bg-red-100 dark:bg-red-900/50 px-3 py-1 text-xs font-medium text-red-700 dark:text-red-300">Expired</span>
											</td>
											<td class="h-[72px] px-4 py-2 text-right text-red-600 dark:text-red-400 text-sm font-medium leading-normal">-10</td>
											<td class="h-[72px] px-4 py-2 text-right text-slate-500 dark:text-slate-400 text-sm font-normal leading-normal">1,400 pts</td>
										</tr> #}
									</tbody>
								</table>
							</div>
						</div>

						<!-- EmptyState (Example, would be shown conditionally) -->
						{@ if transactions is empty @}
						<div class="flex flex-col px-4 py-20 border border-dashed border-slate-300 dark:border-slate-700 rounded-xl">
						    <div class="flex flex-col items-center gap-6 text-center">
						        <div class="flex items-center justify-center size-16 bg-slate-100 dark:bg-slate-800 rounded-full text-primary">
						            <span class="material-symbols-outlined !text-4xl">history</span>
						        </div>
						        <div class="flex max-w-sm flex-col items-center gap-2">
						            <p class="text-slate-900 dark:text-white text-lg font-bold leading-tight tracking-[-0.015em]">No Points Activity Yet</p>
						            <p class="text-slate-500 dark:text-slate-400 text-sm font-normal leading-normal">You don’t have any points activity to show for the selected period.</p>
						        </div>
						        <button class="flex min-w-[84px] max-w-[480px] cursor-pointer items-center justify-center overflow-hidden rounded-lg h-10 px-4 bg-slate-200 dark:bg-slate-800 text-slate-900 dark:text-white text-sm font-bold leading-normal tracking-[0.015em]">
						            <span class="truncate">Clear Filters</span>
						        </button>
						    </div>
						</div> 
						{@ endif @}
					</div>
				</div>
			</div>
		</div>
	</body>
</html>
