<!DOCTYPE html>

<html class="light" lang="en">
	<head>
		<meta charset="utf-8"/>
		<meta content="width=device-width, initial-scale=1.0" name="viewport"/>
		<title>Checkout - ShopEasy</title>
		<!-- Tailwind CSS -->
		<script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
		<!-- Material Symbols -->
		<link
		href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap" rel="stylesheet"/>
		<!-- Google Fonts: Inter -->
		<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&amp;display=swap" rel="stylesheet"/>
		<link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap" rel="stylesheet"/>
		<script id="tailwind-config">
			tailwind.config = {
darkMode: "class",
theme: {
extend: {
colors: {
"primary": "#136dec",
"background-light": "#f6f7f8",
"background-dark": "#101822"
},
fontFamily: {
"display": ["Inter"]
},
borderRadius: {
"DEFAULT": "0.25rem",
"lg": "0.5rem",
"xl": "0.75rem",
"full": "9999px"
}
}
}
}
		</script>
		<style>
			.material-symbols-outlined {
				font-variation-settings: 'FILL' 0, 'wght' 400, 'GRAD' 0, 'opsz' 24;
			}
			body {
				font-family: 'Inter', sans-serif;
			}
		</style>
	</head>
	<body class="bg-background-light dark:bg-background-dark text-[#0d131b] dark:text-slate-50 transition-colors duration-200">
		<div class="relative flex min-h-screen w-full flex-col group/design-root overflow-x-hidden">
			<div
				class="layout-container flex h-full grow flex-col">
				<!-- TopNavBar -->
				<header class="flex items-center justify-between whitespace-nowrap border-b border-solid border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 px-10 py-3 sticky top-0 z-50">
					<div class="flex items-center gap-4 text-[#0d131b] dark:text-white">
						<div class="size-6 text-primary">
							<svg fill="none" viewbox="0 0 48 48" xmlns="http://www.w3.org/2000/svg">
								<path clip-rule="evenodd" d="M24 0.757355L47.2426 24L24 47.2426L0.757355 24L24 0.757355ZM21 35.7574V12.2426L9.24264 24L21 35.7574Z" fill="currentColor" fill-rule="evenodd"></path>
							</svg>
						</div>
						<h2 class="text-[#0d131b] dark:text-white text-lg font-bold leading-tight tracking-[-0.015em]">ShopEasy</h2>
					</div>
					<div class="flex flex-1 justify-end gap-8">
						<div class="hidden md:flex items-center gap-9">
							<a class="text-sm font-medium leading-normal hover:text-primary transition-colors" href="#">Shop</a>
							<a class="text-sm font-medium leading-normal hover:text-primary transition-colors" href="#">Categories</a>
							<a class="text-sm font-medium leading-normal hover:text-primary transition-colors" href="#">Deals</a>
							<a class="text-sm font-medium leading-normal hover:text-primary transition-colors" href="#">Support</a>
						</div>
						<div class="flex gap-2">
							<button class="flex items-center justify-center rounded-lg h-10 bg-slate-100 dark:bg-slate-800 text-[#0d131b] dark:text-white px-3 hover:bg-slate-200 dark:hover:bg-slate-700 transition-colors">
								<span class="material-symbols-outlined">shopping_cart</span>
							</button>
							<button class="flex items-center justify-center rounded-lg h-10 bg-slate-100 dark:bg-slate-800 text-[#0d131b] dark:text-white px-3 hover:bg-slate-200 dark:hover:bg-slate-700 transition-colors">
								<span class="material-symbols-outlined">account_circle</span>
							</button>
						</div>
					</div>
				</header>
				<main class="flex flex-1 justify-center py-8">
					<div
						class="layout-content-container flex flex-col max-w-[1200px] flex-1 px-4 lg:px-10">
						<!-- Breadcrumbs -->
						<div class="flex flex-wrap gap-2 py-4">
							<a class="text-[#4c6c9a] dark:text-slate-400 text-sm font-medium leading-normal" href="#">Cart</a>
							<span class="text-[#4c6c9a] dark:text-slate-500 text-sm font-medium leading-normal">/</span>
							<a class="text-[#0d131b] dark:text-white text-sm font-medium leading-normal" href="#">Shipping &amp; Payment</a>
							<span class="text-[#4c6c9a] dark:text-slate-500 text-sm font-medium leading-normal">/</span>
							<span class="text-[#4c6c9a] dark:text-slate-500 text-sm font-medium leading-normal">Confirmation</span>
						</div>
						<!-- PageHeading -->
						<div class="flex flex-wrap justify-between gap-3 pb-8">
							<h1 class="text-[#0d131b] dark:text-white text-4xl font-black leading-tight tracking-[-0.033em]">Checkout</h1>
						</div>
						<div
							class="grid grid-cols-1 lg:grid-cols-3 gap-8 items-start">
							<!-- Left Column: Shipping and Payment -->
							<div
								class="lg:col-span-2 space-y-8">
								<!-- Shipping Section -->
								<section class="bg-white dark:bg-slate-900 rounded-xl p-6 shadow-sm border border-slate-200 dark:border-slate-800">
									<h2 class="text-[#0d131b] dark:text-white text-xl font-bold leading-tight pb-6 border-b border-slate-100 dark:border-slate-800 mb-6">1. Shipping Information</h2>
									<div class="grid grid-cols-1 md:grid-cols-2 gap-4">
										<div class="flex flex-col gap-1">
											<p class="text-sm font-medium text-slate-700 dark:text-slate-300">First Name</p>
											<input class="form-input w-full rounded-lg border border-slate-200 dark:border-slate-700 bg-slate-50 dark:bg-slate-800 text-[#0d131b] dark:text-white focus:ring-2 focus:ring-primary focus:border-primary h-12 px-4 text-base transition-all" placeholder="John" type="text"/>
										</div>
										<div class="flex flex-col gap-1">
											<p class="text-sm font-medium text-slate-700 dark:text-slate-300">Last Name</p>
											<input class="form-input w-full rounded-lg border border-slate-200 dark:border-slate-700 bg-slate-50 dark:bg-slate-800 text-[#0d131b] dark:text-white focus:ring-2 focus:ring-primary focus:border-primary h-12 px-4 text-base transition-all" placeholder="Doe" type="text"/>
										</div>
										<div class="flex flex-col gap-1 md:col-span-2">
											<p class="text-sm font-medium text-slate-700 dark:text-slate-300">Address line 1</p>
											<input class="form-input w-full rounded-lg border border-slate-200 dark:border-slate-700 bg-slate-50 dark:bg-slate-800 text-[#0d131b] dark:text-white focus:ring-2 focus:ring-primary focus:border-primary h-12 px-4 text-base transition-all" placeholder="123 Shopping Avenue" type="text"/>
										</div>
										<div class="flex flex-col gap-1">
											<p class="text-sm font-medium text-slate-700 dark:text-slate-300">City</p>
											<input class="form-input w-full rounded-lg border border-slate-200 dark:border-slate-700 bg-slate-50 dark:bg-slate-800 text-[#0d131b] dark:text-white focus:ring-2 focus:ring-primary focus:border-primary h-12 px-4 text-base transition-all" placeholder="New York" type="text"/>
										</div>
										<div class="flex flex-col gap-1">
											<p class="text-sm font-medium text-slate-700 dark:text-slate-300">Zip Code</p>
											<input class="form-input w-full rounded-lg border border-slate-200 dark:border-slate-700 bg-slate-50 dark:bg-slate-800 text-[#0d131b] dark:text-white focus:ring-2 focus:ring-primary focus:border-primary h-12 px-4 text-base transition-all" placeholder="10001" type="text"/>
										</div>
									</div>
								</section>
								<!-- Payment Section -->
								<section class="bg-white dark:bg-slate-900 rounded-xl p-6 shadow-sm border border-slate-200 dark:border-slate-800">
									<h2 class="text-[#0d131b] dark:text-white text-xl font-bold leading-tight pb-6 border-b border-slate-100 dark:border-slate-800 mb-6">2. Payment Method</h2>
									<div
										class="space-y-4">
										<!-- Credit Card Option -->
										<div class="p-4 rounded-lg border-2 border-primary bg-primary/5 dark:bg-primary/10">
											<label class="flex items-center gap-3 cursor-pointer mb-4">
												<input checked="" class="text-primary focus:ring-primary h-5 w-5" name="payment" type="radio"/>
												<span class="font-bold text-[#0d131b] dark:text-white flex items-center gap-2">
													<span class="material-symbols-outlined">credit_card</span>
													Credit or Debit Card
												</span>
											</label>
											<div class="grid grid-cols-1 md:grid-cols-2 gap-4 ml-8">
												<div class="flex flex-col gap-1 md:col-span-2">
													<p class="text-xs font-medium text-slate-600 dark:text-slate-400">Card Number</p>
													<input class="form-input w-full rounded-lg border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800 text-[#0d131b] dark:text-white h-11 px-4 text-sm" placeholder="0000 0000 0000 0000" type="text"/>
												</div>
												<div class="flex flex-col gap-1">
													<p class="text-xs font-medium text-slate-600 dark:text-slate-400">Expiration Date</p>
													<input class="form-input w-full rounded-lg border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800 text-[#0d131b] dark:text-white h-11 px-4 text-sm" placeholder="MM/YY" type="text"/>
												</div>
												<div class="flex flex-col gap-1">
													<p class="text-xs font-medium text-slate-600 dark:text-slate-400">CVV</p>
													<input class="form-input w-full rounded-lg border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800 text-[#0d131b] dark:text-white h-11 px-4 text-sm" placeholder="***" type="password"/>
												</div>
											</div>
										</div>
										<!-- PayPal Option -->
										<div class="p-4 rounded-lg border border-slate-200 dark:border-slate-800 hover:border-slate-300 dark:hover:border-slate-700 transition-colors">
											<label class="flex items-center gap-3 cursor-pointer">
												<input class="text-primary focus:ring-primary h-5 w-5" name="payment" type="radio"/>
												<span class="font-bold text-[#0d131b] dark:text-white flex items-center gap-2">
													<span class="material-symbols-outlined">payments</span>
													PayPal
												</span>
											</label>
										</div>
									</div>
								</section>
								<!-- Trust Badges Footer -->
								<div class="flex justify-center gap-8 py-4 opacity-50 grayscale hover:grayscale-0 transition-all duration-300">
									<div class="flex flex-col items-center gap-1">
										<span class="material-symbols-outlined text-3xl">verified_user</span>
										<span class="text-[10px] uppercase tracking-widest font-bold">Secure Checkout</span>
									</div>
									<div class="flex flex-col items-center gap-1">
										<span class="material-symbols-outlined text-3xl">lock</span>
										<span class="text-[10px] uppercase tracking-widest font-bold">SSL Encrypted</span>
									</div>
									<div class="flex flex-col items-center gap-1">
										<span class="material-symbols-outlined text-3xl">local_shipping</span>
										<span class="text-[10px] uppercase tracking-widest font-bold">Fast Delivery</span>
									</div>
								</div>
							</div>
							<!-- Right Column: Order Summary (Sticky Sidebar) -->
							<div class="lg:sticky lg:top-24 space-y-4">
								<div class="bg-white dark:bg-slate-900 rounded-xl shadow-lg border border-slate-200 dark:border-slate-800 overflow-hidden">
									<div class="p-6">
										<h3 class="text-[#0d131b] dark:text-white text-lg font-bold mb-4">Step 1: Order Summary</h3>
										<!-- Simple Item Preview -->
										<div class="space-y-4 mb-6">
											<div class="flex items-center gap-3">
												<div class="size-12 bg-slate-100 dark:bg-slate-800 rounded-lg flex items-center justify-center text-slate-400">
													<span class="material-symbols-outlined">image</span>
												</div>
												<div class="flex-1">
													<p class="text-sm font-semibold dark:text-white">Premium Wireless Headphones</p>
													<p class="text-xs text-[#4c6c9a] dark:text-slate-400">Qty: 1</p>
												</div>
												<p class="text-sm font-bold">$299.00</p>
											</div>
											<div class="flex items-center gap-3">
												<div class="size-12 bg-slate-100 dark:bg-slate-800 rounded-lg flex items-center justify-center text-slate-400">
													<span class="material-symbols-outlined">image</span>
												</div>
												<div class="flex-1">
													<p class="text-sm font-semibold dark:text-white">Leather Travel Bag</p>
													<p class="text-xs text-[#4c6c9a] dark:text-slate-400">Qty: 1</p>
												</div>
												<p class="text-sm font-bold">$125.00</p>
											</div>
										</div>
										<!-- Price Breakdown -->
										<div class="space-y-3 py-4 border-t border-slate-100 dark:border-slate-800">
											<div class="flex justify-between text-sm text-[#4c6c9a] dark:text-slate-400">
												<span>Subtotal</span>
												<span>$424.00</span>
											</div>
											<div class="flex justify-between text-sm text-[#4c6c9a] dark:text-slate-400">
												<span>Shipping</span>
												<span class="text-green-600 font-medium">Free</span>
											</div>
											<div class="flex justify-between text-sm text-[#4c6c9a] dark:text-slate-400">
												<span>Estimated Tax</span>
												<span>$33.92</span>
											</div>
											<div class="flex justify-between text-xl font-black text-[#0d131b] dark:text-white pt-2">
												<span>Total</span>
												<span>$457.92</span>
											</div>
										</div>
										<!-- Loyalty Message -->
										<div class="mt-4 p-4 bg-primary/10 dark:bg-primary/20 rounded-lg border border-primary/20 flex items-start gap-3">
											<span class="material-symbols-outlined text-primary mt-0.5" style="font-variation-settings: 'FILL' 1">stars</span>
											<p class="text-sm font-semibold text-primary-dark dark:text-blue-300 leading-snug">
												You will earn 458 points with this purchase!
											</p>
										</div>
										<!-- Primary CTA -->
										<button class="w-full mt-6 bg-primary hover:bg-primary/90 text-white font-bold py-4 rounded-xl shadow-md shadow-primary/30 transition-all flex items-center justify-center gap-2 group">
											Complete Purchase
											<span class="material-symbols-outlined group-hover:translate-x-1 transition-transform">arrow_forward</span>
										</button>
										<p class="text-[10px] text-center text-slate-500 mt-4 leading-relaxed">
											By clicking "Complete Purchase", you agree to our
											<a class="underline" href="#">Terms of Service</a>
											and
											<a class="underline" href="#">Return Policy</a>.
										</p>
									</div>
								</div>
								<!-- Support Widget -->
								<div class="bg-slate-100 dark:bg-slate-800 rounded-lg p-4 flex items-center gap-4">
									<span class="material-symbols-outlined text-primary">support_agent</span>
									<div>
										<p class="text-xs font-bold">Need help with your order?</p>
										<p class="text-[10px] text-slate-500">Contact our support team 24/7</p>
									</div>
								</div>
							</div>
						</div>
					</div>
				</main>
				<!-- Footer Small -->
				<footer class="py-10 border-t border-slate-200 dark:border-slate-800 px-10 text-center">
					<p class="text-sm text-slate-500">© 2023 ShopEasy Inc. All rights reserved.</p>
				</footer>
			</div>
		</div>
	</body>
</html>
